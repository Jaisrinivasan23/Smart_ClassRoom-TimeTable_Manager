# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/smart-classroom

# Email Configuration (Gmail SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true

# Test Mode (set to true for development, false for production)
TEST_MODE=true

# Test Recipients (used when TEST_MODE=true)
TEST_EMAIL_TO=test-email@gmail.com
TEST_PHONE_NUMBER=+1234567890

# Feature Flags
SEND_TO_ALL_ROLES=true

# AI Services
GOOGLE_API_KEY=your-google-api-key
HUGGING_FACE_API_KEY=your-hugging-face-api-key

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
